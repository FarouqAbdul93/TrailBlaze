<article class="trail-card" aria-label="Trail: @Trail.Name">
    <h3>@Trail.Name</h3>
    <p><span aria-hidden="true">📍</span> <span class="sr-only">Location:</span> @Trail.Location</p>
    <p><span aria-hidden="true">📏</span> <span class="sr-only">Distance:</span> @Trail.DistanceMiles miles</p>
    <p><span aria-hidden="true">💪</span> <span class="sr-only">Difficulty:</span> @Trail.Difficulty</p>
    @if (Trail.AverageRating > 0)
    {
        <p><span aria-hidden="true">⭐</span> <span class="sr-only">Rating:</span> @Trail.AverageRating.ToString("0.0") / 5</p>
    }
    else
    {
        <p><span aria-hidden="true">⭐</span> No ratings yet</p>
    }
    <a href="/trails/@Trail.TrailId"
       class="btn-view"
       aria-label="View details for @Trail.Name">View Trail</a>
</article>

@code {
    [Parameter]
    public TrailCard.TrailCardModel Trail { get; set; } = new();

    public class TrailCardModel
    {
        public int TrailId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Location { get; set; } = string.Empty;
        public double DistanceMiles { get; set; }
        public string Difficulty { get; set; } = string.Empty;
        public double AverageRating { get; set; }
    }
}