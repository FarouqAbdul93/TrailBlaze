@page "/"
@inject TrailService TrailService
@inject NavigationManager Navigation
@using TrailBlaze.UI.Services
@rendermode InteractiveServer
<PageTitle>TrailBlaze - Find Your Trail</PageTitle>

<div class="home-container">
    <h1>🏔️ Find Your Perfect Trail</h1>
    <p>Discover walking and hiking trails across the UK</p>

    <div class="search-form" role="search">
        <div class="form-group">
            <label for="locationInput">Location</label>
            <input type="text"
                   id="locationInput"
                   @bind="location"
                   @bind:event="oninput"
                   placeholder="e.g. Lake District, Peak District"
                   class="form-control"
                   aria-label="Enter location to search for trails" />
        </div>

        <div class="form-group">
            <label for="difficultySelect">Difficulty</label>
            <select id="difficultySelect"
                    @bind="difficulty"
                    class="form-control"
                    aria-label="Select trail difficulty">
                <option value="">All Difficulties</option>
                <option value="Easy">Easy</option>
                <option value="Moderate">Moderate</option>
                <option value="Hard">Hard</option>
            </select>
        </div>

        <button @onclick="SearchTrails"
                class="btn-search"
                aria-label="Search for trails">
            Search Trails
        </button>
    </div>
</div>

@code {
    private string location = "";
    private string difficulty = "";

    private void SearchTrails()
    {
        if (!string.IsNullOrEmpty(location))
        {
            Navigation.NavigateTo($"/trails?location={location}&difficulty={difficulty}");
        }
        else
        {
            Navigation.NavigateTo("/trails");
        }
    }
}
