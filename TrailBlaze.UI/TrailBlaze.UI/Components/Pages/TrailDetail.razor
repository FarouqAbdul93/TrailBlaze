@page "/trails/{TrailId:int}"
@inject TrailService TrailService
@inject IJSRuntime JS
@inject IConfiguration Configuration
@using TrailBlaze.UI.Services
<PageTitle>TrailBlaze - Trail Detail</PageTitle>

<div class="trail-detail-container">
    @if (trail == null)
    {
        <p>Loading trail...</p>
    }
    else
    {
        <div class="trail-detail">
            <h1>🏔️ @trail.Name</h1>
            <p>📍 <strong>Location:</strong> @trail.Location</p>
            <p>📏 <strong>Distance:</strong> @trail.DistanceMiles miles</p>
            <p>💪 <strong>Difficulty:</strong> @trail.Difficulty</p>
            <p>📝 <strong>Description:</strong> @trail.Description</p>
            <p>⭐ <strong>Rating:</strong> @(trail.AverageRating > 0 ? trail.AverageRating.ToString("0.0") + " / 5" : "No ratings yet")</p>

            <button onclick="@($"showAndInitMap('{mapboxToken}', {trail.Latitude}, {trail.Longitude}, '{trail.Name}')")" class="btn-map">Show Map</button>

            <div id="map" style="width:100%; height:400px; margin-top:20px; display:none;"></div>

            <div class="trail-actions" style="margin-top:20px;">
                <button class="btn-directions" @onclick="GetDirections">Get Directions</button>
                <button class="btn-start">Start Hike</button>
            </div>

            <div style="margin-top:30px;">
                <ReviewForm TrailId="TrailId" />
            </div>
        </div>
    }

    <a href="/trails">← Back to Trails</a>
</div>

@code {
    [Parameter]
    public int TrailId { get; set; }

    private TrailDto? trail;
    private string mapboxToken = "";

    protected override async Task OnInitializedAsync()
    {
        mapboxToken = Configuration["MapboxToken"] ?? "";
        trail = await TrailService.GetTrailByIdAsync(TrailId);
    }

    private async Task GetDirections()
    {
        if (trail != null)
        {
            await JS.InvokeVoidAsync("showAndInitMap", mapboxToken, trail.Latitude, trail.Longitude, trail.Name);
        }
    }
}