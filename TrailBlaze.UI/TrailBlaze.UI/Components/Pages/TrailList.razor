@page "/trails"
@inject TrailService TrailService
@inject NavigationManager Navigation
@using TrailBlaze.UI.Services
@using Microsoft.AspNetCore.WebUtilities
<PageTitle>TrailBlaze - Trails</PageTitle>

<div class="trail-list-container">
    <h1>🥾 Trails</h1>

    @if (isLoading && !trails.Any())
    {
        <p>Loading trails... please wait</p>
    }
    else if (trails.Any())
    {
        @if (!string.IsNullOrEmpty(searchLocation))
        {
            <p>Found <strong>@totalCount</strong> trails matching <strong>@searchLocation</strong></p>
        }
        else
        {
            <p>Showing <strong>@trails.Count</strong> of <strong>@totalCount</strong> trails</p>
        }

        <div class="trail-grid">
            @foreach (var trail in trails)
            {
                <TrailCard Trail="new TrailCard.TrailCardModel
                           {
                               TrailId = trail.TrailId,
                               Name = trail.Name,
                               Location = trail.Location,
                               DistanceMiles = trail.DistanceMiles,
                               Difficulty = trail.Difficulty,
                               AverageRating = trail.AverageRating
                           }" />
                }
        </div>

        @if (hasMore)
        {
            <div style="text-align:center; margin-top:2rem;">
                <button @onclick="LoadMore" class="btn-search" disabled="@isLoading">
                    @(isLoading ? "Loading..." : "Load More Trails")
                </button>
            </div>
        }
    }
    else if (!isLoading)
    {
        <p>No trails found. Try a different search.</p>
    }
</div>

@code {
    private List<TrailDto> trails = new();
    private string searchLocation = "";
    private bool isLoading = false;
    private bool hasMore = false;
    private int currentPage = 1;
    private int totalCount = 0;
    private const int PageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("location", out var location) && !string.IsNullOrEmpty(location))
        {
            searchLocation = location!;
            isLoading = true;
            var results = await TrailService.SearchTrailsAsync(searchLocation);
            trails = results ?? new List<TrailDto>();
            totalCount = trails.Count;
            hasMore = false;
            isLoading = false;
        }
        else if (query.TryGetValue("difficulty", out var difficulty) && !string.IsNullOrEmpty(difficulty))
        {
            isLoading = true;
            var results = await TrailService.GetTrailsByDifficultyAsync(difficulty!);
            trails = results ?? new List<TrailDto>();
            totalCount = trails.Count;
            hasMore = false;
            isLoading = false;
        }
        else
        {
            await LoadPage(1);
        }
    }

    private async Task LoadPage(int pageNumber)
    {
        isLoading = true;
        var paged = await TrailService.GetTrailsPagedAsync(pageNumber, PageSize);
        if (paged != null)
        {
            trails.AddRange(paged.Trails);
            totalCount = paged.TotalCount;
            hasMore = paged.HasMore;
            currentPage = pageNumber;
        }
        isLoading = false;
    }

    private async Task LoadMore()
    {
        await LoadPage(currentPage + 1);
    }
}