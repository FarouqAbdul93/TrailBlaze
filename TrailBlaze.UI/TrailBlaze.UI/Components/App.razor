<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="TrailBlaze.UI.styles.css" />
    <link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>
    <script src="mapbox.js"></script>
    <script>
        window.readFileAsBase64 = function(inputId) {
            return new Promise((resolve, reject) => {
                const input = document.getElementById(inputId);
                if (!input || !input.files || !input.files[0]) {
                    reject('No file selected');
                    return;
                }
                const file = input.files[0];
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result.split(',')[1]);
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        };

        window.initCloudinaryUpload = function(cloudName, uploadPreset, apiBaseUrl) {
            window.uploadToCloudinary = function() {
                const input = document.getElementById('imageFileInput');
                if (!input || !input.files || !input.files[0]) {
                    document.getElementById('uploadStatus').innerText = 'Please select a file first';
                    return;
                }
                const file = input.files[0];
                const formData = new FormData();
                formData.append('file', file);
                formData.append('upload_preset', uploadPreset);
                document.getElementById('uploadStatus').innerText = 'Uploading...';
                fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.secure_url) {
                        const trailId = parseInt(document.getElementById('trailIdInput').value);
                        fetch(`${apiBaseUrl}api/Reviews`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                trailId: trailId,
                                rating: 5,
                                comment: '',
                                imageUrl: data.secure_url
                            })
                        })
                        .then(() => {
                            document.getElementById('uploadStatus').innerText = '✅ Photo uploaded successfully!';
                            console.log('Uploaded:', data.secure_url);
                        })
                        .catch(error => {
                            document.getElementById('uploadStatus').innerText = '✅ Photo uploaded but failed to save: ' + error.message;
                        });
                    } else {
                        document.getElementById('uploadStatus').innerText = '❌ Upload failed: ' + JSON.stringify(data);
                    }
                })
                .catch(error => {
                    document.getElementById('uploadStatus').innerText = '❌ Error: ' + error.message;
                });
            };
        };

        window.showTrailRoute = function(token, routeData, latitude, longitude, trailName) {
            var mapDiv = document.getElementById('map');
            if (mapDiv) {
                mapDiv.style.display = 'block';
            }
            mapboxgl.accessToken = token;
            const map = new mapboxgl.Map({
                container: 'map',
                style: 'mapbox://styles/mapbox/outdoors-v12',
                center: [longitude, latitude],
                zoom: 11
            });
            new mapboxgl.Marker()
                .setLngLat([longitude, latitude])
                .setPopup(new mapboxgl.Popup().setHTML(`<h3>${trailName}</h3>`))
                .addTo(map);
            map.addControl(new mapboxgl.NavigationControl());
            if (routeData && routeData.length > 10) {
                try {
                    const geojson = JSON.parse(routeData);
                    map.on('load', function() {
                        map.addSource('trail-route', {
                            type: 'geojson',
                            data: {
                                type: 'Feature',
                                properties: {},
                                geometry: geojson
                            }
                        });
                        map.addLayer({
                            id: 'trail-route',
                            type: 'line',
                            source: 'trail-route',
                            layout: {
                                'line-join': 'round',
                                'line-cap': 'round'
                            },
                            paint: {
                                'line-color': '#e85d04',
                                'line-width': 4,
                                'line-opacity': 0.8
                            }
                        });
                    });
                } catch(e) {
                    console.log('Could not parse route data:', e);
                }
            }
        };

        window.startHike = function(token, routeData, latitude, longitude, trailName) {
            var mapDiv = document.getElementById('map');
            if (mapDiv) {
                mapDiv.style.display = 'block';
            }
            mapboxgl.accessToken = token;
            const map = new mapboxgl.Map({
                container: 'map',
                style: 'mapbox://styles/mapbox/outdoors-v12',
                center: [longitude, latitude],
                zoom: 14
            });

            map.addControl(new mapboxgl.NavigationControl());

            map.addControl(new mapboxgl.GeolocateControl({
                positionOptions: { enableHighAccuracy: true },
                trackUserLocation: true,
                showUserHeading: true
            }));

            map.on('load', function() {
                if (routeData && routeData.length > 10) {
                    try {
                        const geojson = JSON.parse(routeData);
                        map.addSource('trail-route', {
                            type: 'geojson',
                            data: {
                                type: 'Feature',
                                properties: {},
                                geometry: geojson
                            }
                        });
                        map.addLayer({
                            id: 'trail-route',
                            type: 'line',
                            source: 'trail-route',
                            layout: {
                                'line-join': 'round',
                                'line-cap': 'round'
                            },
                            paint: {
                                'line-color': '#e85d04',
                                'line-width': 5,
                                'line-opacity': 0.9
                            }
                        });
                    } catch(e) {
                        console.log('Could not parse route data:', e);
                    }
                }

                new mapboxgl.Marker({ color: '#2c3e2d' })
                    .setLngLat([longitude, latitude])
                    .setPopup(new mapboxgl.Popup().setHTML(`<h3>Start: ${trailName}</h3>`))
                    .addTo(map);

                setTimeout(() => {
                    const geolocate = document.querySelector('.mapboxgl-ctrl-geolocate');
                    if (geolocate) geolocate.click();
                }, 1000);
            });
        };
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>